{
  "name": "antigravity-inline-editor",
  "version": "0.6.0",
  "description": "Unofficial inline editor for the Antigravity desktop app: an Edits tab with autosave, find and replace, and Comment/Quote on selections.",
  "license": "MIT",
  "author": "Mustafa Akben",
  "type": "module",
  "bin": {
    "antigravity-inline-editor": "bin/cli.mjs"
  },
  "files": [
    "bin/",
    "host/",
    "runtime/",
    "dist/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.4"
  },
  "os": [
    "darwin",
    "win32",
    "linux"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:check": "node scripts/build.mjs --check",
    "test": "node --test \"test/**/*.test.mjs\"",
    "check": "npm test && npm run build:check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mustafaakben/antigravity-inline-editor.git"
  },
  "keywords": [
    "antigravity",
    "editor",
    "codemirror",
    "markdown",
    "autosave"
  ],
  "devDependencies": {
    "codemirror": "6.0.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@codemirror/commands": "6.11.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/language": "6.13.1",
    "@lezer/highlight": "1.2.5",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "esbuild": "0.28.2"
  }
}
